# Copy to .env and fill in. NEVER commit .env.

LLM_PROVIDER=          # gemini | openai | groq | openrouter | ollama
LLM_MODEL=             # exact model id, e.g. gemini-2.5-flash
LLM_API_KEY=           # your API key (leave empty for ollama)
LLM_BASE_URL=          # custom base URL (leave empty for provider default)
LLM_TIMEOUT_S=         # per-attempt HTTP timeout in seconds (default: 8.0)
LLM_MAX_ATTEMPTS=      # total attempts incl. repair retry (default: 2)
LLM_TOTAL_BUDGET_S=    # hard wall-clock cap for LLM work per request (default: 15.0)
LLM_TEMPERATURE=       # model temperature (default: 0.0)
LLM_MAX_OUTPUT_TOKENS= # max output tokens (default: 700)
LLM_CACHE_SIZE=        # LRU cache entries (default: 256)
LLM_CACHE_ENABLED=     # true | false (default: true)
BACKUP_LLM_PROVIDER=   # backup provider (optional)
BACKUP_LLM_MODEL=      # backup model (optional)
BACKUP_LLM_API_KEY=    # backup API key (optional)
STRICT_NOTE_COUNT=     # true | false (default: false)
PORT=                  # server port (default: 8000)
LOG_LEVEL=             # DEBUG | INFO | WARNING | ERROR (default: INFO)
